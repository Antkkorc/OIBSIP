<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/paper"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="18dp"
    android:paddingRight="20dp"
    android:paddingBottom="18dp">

    <TextView
        style="@style/Text.Legend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/confirm_legend" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/ink" />

    <TextView
        style="@style/Text.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/confirm_title"
        android:textSize="27sp" />

    <TextView
        android:id="@+id/confirmEntry"
        style="@style/Text.Value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="14sp" />

    <TextView
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/confirm_body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/cancelButton"
            style="@style/Widget.Instrument.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="@dimen/action_height"
            android:layout_weight="1"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/deleteButton"
            style="@style/Widget.Instrument.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/action_height"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:text="@string/delete" />
    </LinearLayout>
</LinearLayout>
