<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/paper"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="18dp"
    android:paddingRight="20dp"
    android:paddingBottom="18dp">

    <TextView
        style="@style/Text.Legend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_legend" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/ink" />

    <TextView
        style="@style/Text.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/dialog_title"
        android:textSize="27sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:minHeight="@dimen/row_min"
        android:orientation="horizontal">

        <TextView
            style="@style/Text.Legend"
            android:layout_width="@dimen/gutter"
            android:layout_height="wrap_content"
            android:text="@string/dialog_label_title" />

        <EditText
            android:id="@+id/titleInput"
            style="@style/Widget.Instrument.Field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_task"
            android:imeOptions="actionNext"
            android:inputType="textCapSentences"
            android:maxLength="120" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/rule" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:minHeight="@dimen/row_min"
        android:orientation="horizontal"
        android:paddingTop="12dp">

        <TextView
            style="@style/Text.Legend"
            android:layout_width="@dimen/gutter"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/dialog_label_notes" />

        <EditText
            android:id="@+id/notesInput"
            style="@style/Widget.Instrument.Field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="top|end"
            android:hint="@string/hint_notes"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="400"
            android:maxLines="3"
            android:minLines="2"
            android:singleLine="false" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/rule" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/cancelButton"
            style="@style/Widget.Instrument.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="@dimen/action_height"
            android:layout_weight="1"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/addButton"
            style="@style/Widget.Instrument.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/action_height"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:text="@string/add" />
    </LinearLayout>
</LinearLayout>
