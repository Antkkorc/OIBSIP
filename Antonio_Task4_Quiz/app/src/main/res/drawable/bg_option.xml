<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/glass_fill" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
        </shape>
    </item>
    <item android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/glass_top"
                android:endColor="@color/glass_bottom" />
            <stroke android:width="1dp" android:color="@color/glass_highlight" />
        </shape>
    </item>
</layer-list>
