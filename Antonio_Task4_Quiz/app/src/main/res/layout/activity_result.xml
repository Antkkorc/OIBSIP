<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="@dimen/screen_pad"
        android:paddingTop="14dp"
        android:paddingRight="@dimen/screen_pad"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Legend"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/masthead_left" />

            <TextView
                style="@style/Text.Legend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/result_legend" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:background="@color/ink" />

        <!-- The score is the dominant object: serif, oversized, left-aligned -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/scoreValue"
                style="@style/Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="78sp"
                android:text="0" />

            <TextView
                android:id="@+id/scoreTotal"
                style="@style/Text.Display.Italic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginBottom="12dp"
                android:layout_weight="1"
                android:text="/ 12"
                android:textColor="@color/ink_muted"
                android:textSize="26sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/verdict"
            style="@style/Text.Display.Italic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginRight="24dp"
            android:textSize="21sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:background="@color/ink" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/row_min"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/Text.Legend"
                android:layout_width="@dimen/gutter"
                android:layout_height="wrap_content"
                android:text="@string/result_correct_label" />

            <TextView
                android:id="@+id/correctValue"
                style="@style/Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/moss" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/rule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/row_min"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/Text.Legend"
                android:layout_width="@dimen/gutter"
                android:layout_height="wrap_content"
                android:text="@string/result_incorrect_label" />

            <TextView
                android:id="@+id/incorrectValue"
                style="@style/Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/oxide" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/rule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/row_min"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/Text.Legend"
                android:layout_width="@dimen/gutter"
                android:layout_height="wrap_content"
                android:text="@string/result_score_label" />

            <TextView
                android:id="@+id/percentValue"
                style="@style/Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ink" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <Button
            android:id="@+id/restartButton"
            style="@style/Widget.Instrument.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_height"
            android:text="@string/restart" />

        <Button
            android:id="@+id/closeButton"
            style="@style/Widget.Instrument.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_height"
            android:layout_marginTop="10dp"
            android:text="@string/close" />

        <TextView
            style="@style/Text.Legend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.08"
            android:text="@string/result_colophon" />
    </LinearLayout>
</ScrollView>
