<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/screen_pad"
            android:paddingTop="14dp"
            android:paddingRight="@dimen/screen_pad">

            <!-- Title block, drawing-sheet corner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Legend"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/masthead_left" />

                <TextView
                    style="@style/Text.Legend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/masthead_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="9dp"
                android:background="@color/ink" />

            <TextView
                style="@style/Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/title" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginRight="18dp"
                android:text="@string/standfirst" />

            <!-- Category selector: four legends, the live one carries the only 2dp rule -->
            <LinearLayout
                android:id="@+id/categoryRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabLength"
                    style="@style/Text.Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_length" />

                <TextView
                    android:id="@+id/tabWeight"
                    style="@style/Text.Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_weight" />

                <TextView
                    android:id="@+id/tabVolume"
                    style="@style/Text.Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_volume" />

                <TextView
                    android:id="@+id/tabTemp"
                    style="@style/Text.Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_temp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/rule" />

            <TextView
                android:id="@+id/categoryNote"
                style="@style/Text.Legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/category_length_note" />

            <!-- 01 VALUE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_min"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Legend"
                    android:layout_width="@dimen/gutter"
                    android:layout_height="wrap_content"
                    android:text="@string/label_value" />

                <EditText
                    android:id="@+id/inputValue"
                    style="@style/Widget.Instrument.Field"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/hint_value"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/rule" />

            <!-- 02 FROM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_min"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Legend"
                    android:layout_width="@dimen/gutter"
                    android:layout_height="wrap_content"
                    android:text="@string/label_from" />

                <Spinner
                    android:id="@+id/fromUnit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:spinnerMode="dropdown" />

                <ImageView
                    android:layout_width="9dp"
                    android:layout_height="6dp"
                    android:layout_marginLeft="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_caret" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/rule" />

            <!-- 03 TO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_min"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Legend"
                    android:layout_width="@dimen/gutter"
                    android:layout_height="wrap_content"
                    android:text="@string/label_to" />

                <Spinner
                    android:id="@+id/toUnit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:spinnerMode="dropdown" />

                <ImageView
                    android:layout_width="9dp"
                    android:layout_height="6dp"
                    android:layout_marginLeft="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_caret" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/rule" />

            <TextView
                android:id="@+id/swapButton"
                style="@style/Widget.Instrument.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:gravity="center"
                android:text="@string/swap" />

            <TextView
                style="@style/Text.Legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:letterSpacing="0.08"
                android:text="@string/colophon" />
        </LinearLayout>
    </ScrollView>

    <!-- Readout anchored to the bottom edge: the one dominant object -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/screen_pad"
        android:paddingTop="10dp"
        android:paddingRight="@dimen/screen_pad"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_readout"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingTop="16dp"
            android:paddingRight="18dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/Text.Legend.OnInk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/result_label" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/resultValue"
                style="@style/Text.Readout.OnInk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:text="@string/result_placeholder"
                app:autoSizeMaxTextSize="42sp"
                app:autoSizeMinTextSize="16sp"
                app:autoSizeStepGranularity="2sp"
                app:autoSizeTextType="uniform" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@color/rule_dark" />

            <TextView
                android:id="@+id/resultSentence"
                style="@style/Text.Caption.OnInk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:maxLines="3"
                android:text="@string/awaiting" />
        </LinearLayout>

        <Button
            android:id="@+id/convertButton"
            style="@style/Widget.Instrument.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_height"
            android:layout_marginTop="12dp"
            android:text="@string/convert" />
    </LinearLayout>

</LinearLayout>
