<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:gravity="bottom" android:height="2dp">
                <shape android:shape="rectangle"><solid android:color="@color/ink" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/paper_shade" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@android:color/transparent" /></shape>
    </item>
</selector>
